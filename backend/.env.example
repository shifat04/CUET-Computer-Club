PORT=5000
# Use your local MongoDB URI or MongoDB Atlas connection string here
MONGO_URI=mongodb://127.0.0.1:27017/cuet-computer-club
JWT_SECRET=replace_with_a_strong_secret
# Comma-separated allowed frontend origins
CORS_ORIGIN=http://127.0.0.1:8080,http://localhost:8080
# API rate limit settings (per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
