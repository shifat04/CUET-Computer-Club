# Backend runtime configuration
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/cuet-computer-club
JWT_SECRET=replace_with_a_strong_secret
CORS_ORIGIN=http://127.0.0.1:8080,http://localhost:8080
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Email configuration
FRONTEND_URL=http://localhost:8080
EMAIL_FROM=no-reply@cuetcc.local
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SENDGRID_API_KEY=

# Seeding mode
SEED_ENV=development
